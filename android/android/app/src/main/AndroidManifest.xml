<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- FCM: the small icon shown in the status bar / notification tray
             for data-only or background notification messages, which
             Android otherwise renders with a plain white square using the
             launcher icon. Must be a monochrome/alpha-only drawable per
             Android's notification icon guidelines — ic_notification_small
             already exists per-density under res/drawable-*dpi. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_small" />
        <!-- Tint applied to that icon; brand navy so it doesn't render as a
             plain white/grey square in the tray. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_icon_color" />
        <!-- Android 8+ (API 26+) requires every notification to be posted on
             a channel. Without a default channel declared here, the FCM SDK
             falls back to one Android auto-creates with no name/importance,
             which on some OEM skins (and always on Android 13+ once the
             runtime permission below is in play) results in the
             notification being silently suppressed instead of shown.
             MUST match the "bookme_default" channel_id hardcoded in the
             send-notification edge function's android.notification payload
             — that per-message value overrides this manifest default, so if
             the two ever drift apart, every push from that function targets
             a channel that doesn't exist on the device and Android silently
             drops it (no error, nothing in Logcat). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bookme_default" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required on Android 13+ (API 33+): without this, the app can still
         call FirebaseMessaging.requestPermissions() and it will resolve,
         but the OS silently denies posting any notification — this is the
         single most common reason push "works" (token saves fine, FCM
         accepts the send) but nothing ever appears on the device. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
